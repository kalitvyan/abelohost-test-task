{
  "name": "kalitvyan/abelohost-test-task",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "smarty/smarty": "^5.4"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "phpstan/phpstan": "^1.11",
    "phpunit/phpunit": "^10.5",
    "friendsofphp/php-cs-fixer": "^3.60"
  },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "config": {
    "platform": { "php": "8.1.0" },
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
