#!/usr/bin/env php
<?php

declare(strict_types=1);

/** @var App\Container $app */
$app = require __DIR__ . '/../bootstrap/app.php';

/**
 * Parses "--key=value" arguments.
 *
 * @param list<string> $args
 * @return array<string, string>
 */
$parseOptions = static function (array $args): array {
    $options = [];

    foreach ($args as $arg) {
        if (preg_match('/^--([a-z][a-z-]*)=(.*)$/', $arg, $m) === 1) {
            $options[$m[1]] = $m[2];
        }
    }

    return $options;
};

$intOption = static function (array $options, string $key, int $default, int $min, int $max): int {
    if (!isset($options[$key])) {
        return $default;
    }

    $value = filter_var($options[$key], FILTER_VALIDATE_INT, ['options' => ['min_range' => $min, 'max_range' => $max]]);

    return $value === false
        ? throw new InvalidArgumentException("--{$key} must be an integer between {$min} and {$max}")
        : $value;
};

$printMigrated = static function (array $names): void {
    if ($names === []) {
        echo "Nothing to migrate.\n";

        return;
    }

    foreach ($names as $name) {
        echo "Migrated: {$name}\n";
    }
};

/** @var array<string, callable(array<string, string>): void> $commands */
$commands = [
    'migrate' => static function () use ($app, $printMigrated): void {
        $printMigrated($app->migrator()->migrate());
    },

    'migrate:fresh' => static function () use ($app, $printMigrated): void {
        $app->migrator()->dropAllTables();
        echo "Dropped all tables.\n";
        $printMigrated($app->migrator()->migrate());
    },

    // Usage: bin/console db:seed [--posts=60] [--seed=42]
    'db:seed' => static function (array $options) use ($app, $intOption): void {
        if (!class_exists(Faker\Factory::class)) {
            throw new RuntimeException('Faker is not installed: run "composer install" with dev dependencies');
        }

        $started = microtime(true);
        $stats = $app->seeder()->run(
            postCount: $intOption($options, 'posts', 60, 1, 5000),
            seed: $intOption($options, 'seed', 42, 0, PHP_INT_MAX),
        );

        printf(
            "Seeded: %d categories, %d posts, %d category links in %.2fs\n",
            $stats['categories'],
            $stats['posts'],
            $stats['links'],
            microtime(true) - $started,
        );
    },
];

$name = $argv[1] ?? null;

if ($name === null || !isset($commands[$name])) {
    fwrite(STDERR, "Usage: bin/console <command> [--option=value]\nAvailable: " . implode(', ', array_keys($commands)) . "\n");
    exit(1);
}

try {
    $commands[$name]($parseOptions(array_slice($argv, 2)));
    exit(0);
} catch (Throwable $e) {
    fwrite(STDERR, sprintf("[%s] %s\n", $e::class, $e->getMessage()));
    exit(1);
}
